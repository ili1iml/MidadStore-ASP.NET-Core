@{
    ViewData["Title"] = "الرئيسية - متجر مِداد";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body {
        background-color: #fdfbf7; 
    }
    .brand-title {
        color: #2c3e50;
        font-family: 'Cairo', sans-serif;
    }
    .category-card {
        width: 190px; 
        height: 190px; 
        
        background-color: #4A5D4E; 
        border: none;
        transition: all 0.35s ease-in-out; 
        cursor: pointer;
    }
    .category-card:hover {
        transform: translateY(-8px) scale(1.03);
        background-color: #3B4A3E; 
        box-shadow: 0 12px 24px rgba(74, 93, 78, 0.25) !important;
    }
     
    .category-icon {
        font-size: 2.8rem;
        color: #fdfbf7; 
        transition: transform 0.3s ease;
    }
    .category-card:hover .category-icon {
        transform: rotate(10deg) scale(1.1);
    }
    
    .category-name {
        color: #4A5D4E;
        font-size: 1.1rem;
        margin-top: 12px;
    }
</style>

<div class="container my-5 py-4">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold brand-title mb-3">مِداد للأدوات الفنية</h1>
        <p class="fs-5 text-muted mx-auto" style="max-width: 600px; line-height: 1.7;">
            مرحباً بكِ في مساحتكِ الإبداعية.. حيث تلتقي الفكرة بالريشة والورقة لتصنع لوحة تحكي قصتكِ.
        </p>
        <div class="mx-auto" style="width: 60px; height: 3px; background-color: #4A5D4E; border-radius: 2px;"></div>
    </div>

    <div class="row justify-content-center gap-5 mt-4">
        @foreach (var category in ViewBag.CategoriesList)
        {
            <div class="col-auto text-center">
                <a asp-controller="Home" asp-action="Products" asp-route-id="@category.Id" class="text-decoration-none">
                    
                    <div class="card rounded-circle d-flex align-items-center justify-content-center mx-auto shadow-sm category-card">
                        <div class="card-body text-center d-flex align-items-center justify-content-center">
                            
                            <i class="bi @category.Icon category-icon"></i>
                            
                        </div>
                    </div>
                    
                    <h6 class="fw-bold category-name">@category.Name</h6>
                    
                </a>
            </div>
        }
    </div>
</div>