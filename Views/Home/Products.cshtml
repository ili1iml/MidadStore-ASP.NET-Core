@{
    ViewData["Title"] = ViewBag.CategoryName != null ? ViewBag.CategoryName.Name : "المنتجات";
}

<style>
    body {
        background-color: #fdfbf7; 
    }
    .product-card {
        border: 1px solid #eaddcf; 
        background-color: #ffffff;
        transition: all 0.3s ease-in-out;
        border-radius: 14px;
        overflow: hidden;
    }
    .product-card:hover {
        transform: translateY(-6px); 
        box-shadow: 0 12px 25px rgba(140, 98, 57, 0.12) !important;
        border-color: #4A5D4E; 
    }
    
    
    .product-img-wrapper {
        height: 240px; 
        background-color: #ffffff; 
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }
    .product-img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain; 
    }

    
    .btn-buy {
        background-color: #4A5D4E;
        color: white;
        border: none;
        font-weight: 600;
        transition: background-color 0.2s;
    }
    .btn-buy:hover {
        background-color: #3B4A3E;
        color: white;
    }
    .back-link {
        color: #4A5D4E;
        font-weight: 600;
        transition: color 0.2s;
    }
    .back-link:hover {
        color: #3B4A3E;
    }
</style>

<div class="container my-5" dir="rtl">
    <div class="mb-4">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none back-link">
            <i class="bi bi-arrow-right-short fs-4 align-middle"></i> العودة للأقسام الرئيسية
        </a>
    </div>

    <div class="d-flex align-items-center gap-3 mb-5 border-bottom pb-3">
        @if (ViewBag.CategoryName != null)
        {
            <i class="bi @ViewBag.CategoryName.Icon fs-2" style="color: #4A5D4E;"></i>
            <h2 class="fw-bold m-0" style="color: #2c3e50;">قسم @ViewBag.CategoryName.Name</h2>
        }
        else
        {
            <h2 class="fw-bold m-0" style="color: #2c3e50;">المنتجات</h2>
        }
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (ViewBag.FilteredProducts != null)
        {
            foreach (var product in ViewBag.FilteredProducts)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm product-card">
                        
                        <div class="product-img-wrapper">
                            <img src="~/images/@product.Image" class="product-img" alt="@product.Name">
                        </div>
                        
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="card-title fw-bold mb-3" style="color: #2c3e50; font-size: 1.05rem; line-height: 1.5;">
                                    @product.Name
                                </h5>
                            </div>
                            
                            <div class="d-flex align-items-center justify-content-between mt-3">
                                <span class="fw-bold fs-5" style="color: #4A5D4E;">@product.Price ر.س</span>
                                <button class="btn btn-buy px-3 py-2 rounded-pill shadow-sm" onclick="addToCart('@product.Name')">
                                    <i class="bi bi-cart-plus me-1"></i> إضافة للسلة
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
    </div>
</div>

<script>
    function addToCart(productName) {
        Swal.fire({
            title: 'تمت الإضافة!',
            text: `تمت إضافة (${productName}) إلى سلة التسوق بنجاح.`,
            icon: 'success',
            confirmButtonColor: '#4A5D4E',
            confirmButtonText: 'حسناً',
            timer: 2500
        });
    }
</script>